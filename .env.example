# ─── Site URL (SEO) ───────────────────────────────────────────────────────────
# Dùng cho canonical, sitemap.xml, robots.txt, Open Graph/Twitter.
# Trên VERCEL: KHÔNG cần đặt — next.config.ts tự lấy VERCEL_PROJECT_PRODUCTION_URL.
# Chỉ đặt biến này khi muốn ép một custom domain cụ thể (không có "/" cuối).
# Local có thể bỏ trống → mặc định http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── Backend API ──────────────────────────────────────────────────────────────
# Local:      http://localhost:5000/api
# Production: https://<tutor-be>.railway.app/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ─── WebSocket Endpoint ────────────────────────────────────────────────────────
NEXT_PUBLIC_SOCKET_URL=https://liflow-be.onrender.com/ws-chat


# ─── Mock mode (no backend needed) ───────────────────────────────────────────
# Set to "true" to use in-memory mock data instead of hitting the real backend.
# All data is stored in localStorage — resets on browser clear/incognito.
# Deploy to Vercel with NEXT_PUBLIC_USE_MOCK=true for a standalone demo.
NEXT_PUBLIC_USE_MOCK=false

# ─── Firebase (Firestore real-time chat + web SDK) ────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef1234567890

# ─── Vercel Web Analytics (widget "Lượt truy cập" trong dashboard admin) ──────
# CHỈ dùng ở server (route /api/admin/analytics). KHÔNG đặt prefix NEXT_PUBLIC_
# cho token — token là BÍ MẬT, không được lộ ra client.
# Tạo token: Vercel → Account Settings → Tokens.
VERCEL_ANALYTICS_TOKEN=your_vercel_access_token
# ID team & project (không bí mật) — mặc định đã trỏ đúng project "liflow",
# chỉ đặt khi cần override.
VERCEL_TEAM_ID=team_mDK8j89iFmrPApMJeNhElbHI
VERCEL_PROJECT_ID=prj_7rb6vidOjgKlWinFIAOz131lozaM
